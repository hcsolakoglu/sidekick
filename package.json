{
  "name": "@hcsolakoglu/sidekick",
  "version": "0.1.0",
  "description": "Persistent local multi-agent orchestration from one portable CLI",
  "type": "module",
  "bin": {
    "sidekick": "./bin/sidekick.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "surface:check": "node scripts/check-surface-drift.mjs",
    "smoke:mock": "npm run build --silent && node scripts/mock-roundtrip.mjs",
    "test": "npm run build --silent && node scripts/run-tests.mjs",
    "prepack": "npm test && npm run surface:check && npm run lint && npm run typecheck && npm run format:check"
  },
  "keywords": [
    "agents",
    "cli",
    "codex",
    "claude",
    "devin",
    "orchestration"
  ],
  "author": "Hasan Can Solakoğlu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcsolakoglu/sidekick.git"
  },
  "bugs": {
    "url": "https://github.com/hcsolakoglu/sidekick/issues"
  },
  "homepage": "https://github.com/hcsolakoglu/sidekick#readme",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.15",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
